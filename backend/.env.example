# Backend environment variables
# Copy this file to .env and fill in the values

# Port for the backend server
PORT=3000

# OpenRouter API key (starts with sk-or-)
# Get yours at: https://openrouter.ai/keys
AI_API_KEY=

# OpenRouter base URL (optional — defaults to OpenRouter)
AI_BASE_URL=https://openrouter.ai/api/v1

# Model identifier (optional — defaults to Llama 3.3 70B free)
# Browse all models at: https://openrouter.ai/models
AI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Allowed frontend origin (used in production CORS)
FRONTEND_URL=http://localhost:5173

# Node environment: development | production
NODE_ENV=development
