# Backend environment variables
# Copy this file to .env and fill in the values

# Port for the backend server
PORT=3000

# AI provider: "mock" or "openrouter"
# Defaults to "mock" so the project runs without an API key.
# Set to "openrouter" for real AI generation (requires AI_API_KEY).
AI_PROVIDER=mock

# OpenRouter API key (only required when AI_PROVIDER=openrouter)
# Get yours at: https://openrouter.ai/keys
AI_API_KEY=

# OpenRouter base URL (optional — defaults to OpenRouter)
AI_BASE_URL=https://openrouter.ai/api/v1

# Model identifier (optional — defaults to gpt-oss-20b free)
# Browse all models at: https://openrouter.ai/models
AI_MODEL=openai/gpt-oss-20b:free

# Allowed frontend origin (used in production CORS)
FRONTEND_URL=http://localhost:5173

# Node environment: development | production
NODE_ENV=development
